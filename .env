# Vorlage: nach .env kopieren und anpassen. Echte Umgebungsvariablen haben Vorrang.
# Datei als UTF-8 speichern; Kommentare nur in eigenen Zeilen (nicht hinter einem Wert).

# SQLite-Datenbank (relativ zum Projektordner oder absolut)
DB_PATH=data/lager.db

# Session endet nach so vielen Sekunden ohne Scan
SESSION_TIMEOUT_S=60

# Gleicher Code innerhalb dieser Millisekunden = Doppel-Scan, wird ignoriert
DEBOUNCE_MS=500
