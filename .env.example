# Vorlage: nach .env kopieren und anpassen. Echte Umgebungsvariablen haben Vorrang.
# Datei als UTF-8 speichern; Kommentare nur in eigenen Zeilen (nicht hinter einem Wert).
# Auf dem Raspberry Pi schreibt deploy/install.sh die Datei /opt/lager/.env selbst.

# SQLite-Datenbank (relativ zum Projektordner oder absolut)
DB_PATH=data/lager.db

# Session endet nach so vielen Sekunden ohne Scan
SESSION_TIMEOUT_S=60

# Gleicher Code innerhalb dieser Millisekunden = Doppel-Scan, wird ignoriert
DEBOUNCE_MS=500

# Weboberfläche
HOST=0.0.0.0
PORT=8000

# Admin-Bereich (leer = Entwicklungspasswort "admin"). SECRET_KEY: beliebige lange Zufallszeichenkette
ADMIN_PASSWORD=
SECRET_KEY=

# Scanner: auto = über Linux-evdev lesen, off = nur Test-Scans im Admin-Bereich
SCANNER=auto
# Teil des Gerätenamens (regulärer Ausdruck); der Inateck BCST-70 meldet sich als "BCST-70…"
SCANNER_NAME=BCST|Inateck|Barcode|Scanner
# Fester Gerätepfad statt Namenssuche, z. B. /dev/input/event5 (leer = Namenssuche)
SCANNER_DEVICE=
# Tastatursprache, die der Scanner sendet: us (Werkseinstellung) oder de
SCANNER_KEYMAP=us

# Datensicherung (leer = Unterordner backups neben der Datenbank)
BACKUP_DIR=
BACKUP_KEEP=14
